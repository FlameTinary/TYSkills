#!/usr/bin/env python3
"""a2 —— aria2 命令行封装（端口/密钥读 ~/.aria2/aria2.conf）

用法:
  a2 add --dir DIR [-p] [-o 文件名] <url|magnet|file.torrent|urls.txt>...  下载到 DIR
  a2 ls [-a] [--name 片段]  列出任务（-a 含已结束，--name 按名字过滤）
  a2 st  全局速率/任务数/并发上限
  a2 info <gid>  任务详情（含目录与文件）
  a2 files <gid>  任务内文件列表
  a2 pause [force] <gid|all>  暂停（force = 立即中断当前分片）
  a2 resume <gid|all>  继续
  a2 rm <gid|all>  移除任务（不删已下文件）
  a2 purge  清空已结束任务列表
  a2 concurrent [N]  查/改并发任务数
  a2 up <rate|0>  上传限速
  a2 down <rate|0>  下载限速

gid 可只用前 6 位以上前缀。concurrent / 限速只对本次运行有效。
搜索用 a2-search，落点用 a2-dest，资源校验用 a2-verify。
"""
import base64
import json
import os
import sys
import urllib.error
import urllib.request

CONF = os.path.expanduser(os.environ.get("A2_CONF", "~/.aria2/aria2.conf"))   # 测试/多实例可换
# a2 自己的配置（服务名）。**不要把这些键写进 aria2.conf**：aria2 不认识的键会打
# `[WARN] Unknown option: …`（无害但每次启动都刷屏），所以 a2 的专有配置单独放一个文件。
RC = os.path.expanduser(os.environ.get("A2_RC", "~/.aria2/a2.conf"))


def key_get(path, key, default):
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return default


def conf_get(key, default):
    """读 aria2.conf（端口/密钥这些 aria2 自己的选项）。"""
    return key_get(CONF, key, default)


def rc_get(key, default):
    """读 a2.conf（a2 专有配置：服务名）。"""
    return key_get(RC, key, default)


PORT = conf_get("rpc-listen-port", "6800")
SECRET = os.environ.get("A2_SECRET") or conf_get("rpc-secret", "")
URL = "http://127.0.0.1:%s/jsonrpc" % PORT
# 服务名：只用于提示信息；与 install-a2.sh 的 A2_SERVICE / a2.conf 的 service= 保持一致
SERVICE = os.environ.get("A2_SERVICE") or rc_get("service", "com.example.aria2")

# 已删除的落点参数：命中时给出明确的迁移提示，而不是含糊的「无法识别」
REMOVED_FLAGS = ("-m", "--movie", "-t", "--tv", "-P", "--private", "-flat", "--flat", "-d")


def service_restart_hint():
    """各平台的服务管理命令（只用于提示信息）。"""
    if sys.platform == "darwin":
        return "launchctl kickstart -k gui/$(id -u)/%s" % SERVICE
    if os.name == "nt":
        return "schtasks /End /TN %s 然后 schtasks /Run /TN %s" % (SERVICE, SERVICE)
    return "systemctl --user restart %s" % SERVICE


def service_status_hint():
    if sys.platform == "darwin":
        return "launchctl print gui/$(id -u)/%s" % SERVICE
    if os.name == "nt":
        return "schtasks /Query /TN %s /V" % SERVICE
    return "systemctl --user status %s" % SERVICE


def require_dir(dest):
    """把调用方给的目录变成 aria2 的 dir。**必填，且必须已存在**。

    a2 不建目录、不判断盘挂没挂载、不算剩余空间、不分类 —— 那些都是 skill 的事
    （`a2-dest check DIR` 负责建目录/挂载判据/空间阈值）。a2 只挡住「给了个不存在的目录」，
    免得 aria2 把文件下到一个谁都没准备的位置。
    """
    if not dest:
        sys.exit("缺少目标目录：a2 add --dir <目录> <输入>\n"
                 "  下载位置由调用方决定（默认目录见 a2-dest，落点检查用 a2-dest check）。")
    p = os.path.abspath(os.path.expanduser(dest))
    if not os.path.isdir(p):
        sys.exit("目录不存在：%s\n  先用 a2-dest check %s 准备落点（建目录 + 挂载/空间检查）。"
                 % (p, p))
    return p


def rpc(method, params=None):
    body = json.dumps({"jsonrpc": "2.0", "id": "a2", "method": method,
                       "params": ["token:%s" % SECRET] + (params or [])}).encode()
    req = urllib.request.Request(URL, data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        res = json.loads(urllib.request.urlopen(req, timeout=15).read())
    except urllib.error.HTTPError as exc:         # aria2 用 HTTP 400 返回 RPC 错误体
        try:
            msg = json.loads(exc.read()).get("error", {}).get("message", "HTTP %s" % exc.code)
        except Exception:                         # noqa: BLE001
            msg = "HTTP %s" % exc.code
        sys.exit("RPC 错误: %s" % msg)
    except Exception as exc:                      # noqa: BLE001
        sys.exit("RPC 不可用(%s): %s\n提示: 确认守护进程在跑（%s）"
                 % (URL, exc, service_status_hint()))
    if "error" in res:
        sys.exit("RPC 错误: %s" % res["error"].get("message"))
    return res["result"]


def human(n):
    n = float(n or 0)
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T":
            return "%.1f%s" % (n, unit)
        n /= 1024


def all_gids():
    return [t["gid"] for t in rpc("aria2.tellActive")] + \
           [t["gid"] for t in rpc("aria2.tellWaiting", [0, 1000])] + \
           [t["gid"] for t in rpc("aria2.tellStopped", [0, 1000])]


def resolve(gid):
    """前缀 → gid 列表。空输入必须直接报错：空前缀会匹配所有任务。"""
    gid = (gid or "").strip()
    if gid == "all":
        return all_gids()
    if not gid:
        sys.exit("缺少 gid，先用 `a2 ls` 查")
    hits = [g for g in all_gids() if g.startswith(gid)]
    if not hits:
        sys.exit("找不到任务: %s" % gid)
    if len(hits) > 1:
        sys.exit("前缀不唯一: %s -> %s" % (gid, " ".join(hits)))
    return hits


def name_of(t):
    # BT 任务优先显示种子名（顶层目录/真实标题），避免 RARBG.txt 之类的小文件
    # 占了 files[0] 导致 ls 看不到真正在下载什么；非 BT 单文件回退到文件名。
    bt = t.get("bittorrent", {}).get("info", {}).get("name")
    if bt:
        return bt
    files = t.get("files") or [{}]
    path = files[0].get("path") or ""
    return os.path.basename(path) or "-"


def row(t):
    return "%-16s %-8s %-20s %-11s %s" % (
        t["gid"], t["status"],
        human(t.get("completedLength", 0)) + "/" + human(t.get("totalLength", 0)),
        human(t.get("downloadSpeed", 0)) + "/s", name_of(t))


ADD_USAGE = """a2 add —— 下载到指定目录
用法: a2 add --dir DIR [-p] [-o 文件名] <url|magnet|file.torrent|urls.txt> ...
  --dir DIR       下到 DIR（必须已存在）
  -p, --pause     加入后先暂停
  -o, --out 名字   保存文件名
输入：URL、磁力、.torrent 文件、文本文件（每行一个链接）。"""


def cmd_add(args):
    if args and args[0] in ("-h", "--help", "help"):
        print(ADD_USAGE)
        return 0
    opts, out, dest = {}, None, None
    while args and args[0].startswith("-"):
        flag, args = args[0], args[1:]
        if flag in ("-p", "--pause"):
            opts["pause"] = "true"
        elif flag == "--dir" and args:
            dest, args = args[0], args[1:]
        elif flag in ("-o", "--out") and args:
            out, args = args[0], args[1:]
        elif flag == "--verify":
            sys.exit("--verify 已移到 skill 层：先用 `a2-verify <磁力>` 校验，再 a2 add。")
        elif flag in REMOVED_FLAGS:
            sys.exit("已移除的选项: %s\n"
                     "  a2 不再决定落点：只用 --dir <目录> 指下到哪，"
                     "分类（电影/剧集/私藏）与入库由 skill 决定。" % flag)
        else:
            sys.exit("无法识别的选项或缺少参数: %s（a2 add 只接受 --dir / -p / -o）" % flag)
    if not args:
        sys.exit("缺少下载目标\n" + ADD_USAGE)

    dest = require_dir(dest)
    note = "→ %s" % dest

    for a in args:
        o = dict(opts)
        if out:
            o["out"] = out
        o["dir"] = dest
        if a.startswith(("http://", "https://", "ftp://", "magnet:", "sftp://")):
            print("+ %s  %s\n    %s" % (rpc("aria2.addUri", [[a], o]), a, note))
        elif a.endswith(".torrent") and os.path.exists(a):
            with open(a, "rb") as fh:
                blob = fh.read()
            gid = rpc("aria2.addTorrent", [base64.b64encode(blob).decode(), [], o])
            print("+ %s  %s\n    %s" % (gid, a, note))
        elif a.endswith(".txt") and os.path.exists(a):
            with open(a) as fh:
                urls = [l.strip() for l in fh if l.strip() and not l.startswith("#")]
            for u in urls:
                print("+ %s  %s\n    %s" % (rpc("aria2.addUri", [[u], dict(o)]), u, note))
        else:
            print("跳过无法识别的内容: %s" % a)


def cmd_ls(args):
    show_all, pattern = False, None
    while args:
        a, args = args[0], args[1:]
        if a in ("-a", "--all"):
            show_all = True
        elif a == "--name" and args:
            pattern = args.pop(0).lower()
        else:
            sys.exit("用法: a2 ls [-a] [--name 片段]")
    stopped = rpc("aria2.tellStopped", [0, 1000])
    groups = [("活动", rpc("aria2.tellActive")),
              ("等待", rpc("aria2.tellWaiting", [0, 1000]))]
    if show_all:
        groups.append(("已结束", stopped))
    shown = 0
    for title, tasks in groups:
        if pattern:
            tasks = [t for t in tasks if pattern in name_of(t).lower()]
        if tasks:
            print("== %s ==" % title)
            for t in tasks:
                print(row(t))
                shown += 1
    if pattern and not shown:
        print("没有名字包含 %r 的任务（已结束的要加 -a 才看得到）" % pattern)
    if stopped and not show_all:
        print("(另有 %d 个已结束任务，`a2 ls -a` 查看，`a2 purge` 清空)" % len(stopped))


def cmd_concurrent(args):
    """查/改同时下载的任务数（max-concurrent-downloads）。"""
    cur = rpc("aria2.getGlobalOption").get("max-concurrent-downloads")
    if not args:
        print("max-concurrent-downloads = %s" % cur)
        return
    val = args[0]
    if not val.isdigit() or int(val) < 1:
        sys.exit("并发任务数要是 >=1 的整数（当前 %s）" % cur)
    rpc("aria2.changeGlobalOption", [{"max-concurrent-downloads": val}])
    print("max-concurrent-downloads = %s（本次运行有效；持久化就改 conf 的 "
          "max-concurrent-downloads 再重启服务：%s）" % (val, service_restart_hint()))


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 0
    cmd, args = argv[1], argv[2:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if cmd in ("find", "grab"):
        sys.exit("a2 %s 已移除：搜索在 skill 层（a2 只管资源的增删改查）。\n"
                 "  a2 find <关键词>      → a2-search <关键词>       （站点在 ~/.aria2/search-sites.conf 里配置）\n"
                 "  a2 grab <序号> --dir D → a2-search <关键词> --json 取磁力 → a2-verify <磁力> → "
                 "a2 add --dir D <磁力>\n"
                 "  见 references/search-sites.md" % cmd)
    if cmd not in ("add", "ls", "list", "st", "info", "files", "pause",
                   "unpause", "resume", "rm", "purge", "concurrent", "up", "down"):
        # 允许省略 add：`a2 --dir D <magnet>`、`a2 <url>`、`a2 -p <链接>` 都当成 add
        args, cmd = argv[1:], "add"

    if cmd == "add":
        cmd_add(args)
    elif cmd in ("ls", "list"):
        cmd_ls(args)
    elif cmd == "st":
        g = rpc("aria2.getGlobalStat")
        opt = rpc("aria2.getGlobalOption")
        print("下载 %s/s  上传 %s/s  活动 %s  等待 %s  已结束 %s  并发上限 %s" % (
            human(g["downloadSpeed"]), human(g["uploadSpeed"]), g["numActive"],
            g["numWaiting"], g["numStopped"], opt.get("max-concurrent-downloads", "?")))
    elif cmd == "info":
        if not args:
            sys.exit("缺少 gid，先用 `a2 ls` 查")
        t = rpc("aria2.tellStatus", [resolve(args[0])[0],
                 ["gid", "status", "totalLength", "completedLength", "downloadSpeed",
                  "uploadSpeed", "connections", "numSeeders", "errorCode", "errorMessage",
                  "dir", "files"]])
        for k in ("gid", "status", "totalLength", "completedLength", "downloadSpeed",
                  "uploadSpeed", "connections", "numSeeders", "errorCode", "errorMessage", "dir"):
            print("%-16s %s" % (k, t.get(k)))
        for f in t.get("files", []):
            print("  [%s] %s %s" % (f.get("index"), human(f.get("length")), f.get("path")))
    elif cmd == "files":
        if not args:
            sys.exit("缺少 gid，先用 `a2 ls` 查")
        for f in rpc("aria2.getFiles", [resolve(args[0])[0]]):
            print("[%s] %s %s" % (f.get("index"), human(f.get("length")), f.get("path")))
    elif cmd in ("pause", "unpause", "resume"):
        force = "force" in args
        if force:
            args = [a for a in args if a != "force"]
        if not args:
            sys.exit("缺少 gid 或 all")
        pausing = cmd == "pause"
        if args[0] == "all":
            meth = ("forcePauseAll" if force else "pauseAll") if pausing else "unpauseAll"
            print(rpc("aria2." + meth) or "OK")
        else:
            meth = ("forcePause" if force else "pause") if pausing else "unpause"
            for gid in resolve(args[0]):
                print(gid, rpc("aria2." + meth, [gid]))
    elif cmd == "rm":
        if not args:
            sys.exit("缺少 gid 或 all")
        stopped = [t["gid"] for t in rpc("aria2.tellStopped", [0, 1000])]
        for gid in (all_gids() if args[0] == "all" else resolve(args[0])):
            try:
                if gid in stopped:
                    rpc("aria2.removeDownloadResult", [gid])   # 已结束：清结果
                else:
                    rpc("aria2.forceRemove", [gid])            # 活动/等待：直接摘掉
            except SystemExit as exc:
                print("跳过 %s (%s)" % (gid, exc))
                continue
            print("已移除 %s" % gid)
        rpc("aria2.saveSession")
    elif cmd == "purge":
        print(rpc("aria2.purgeDownloadResult") or "已清空")
    elif cmd == "concurrent":
        cmd_concurrent(args)
    elif cmd in ("up", "down"):
        if not args:
            sys.exit("缺少速率，如 1M / 0")
        key = "max-overall-upload-limit" if cmd == "up" else "max-overall-download-limit"
        val = "0" if args[0] in ("0", "off") else args[0]
        rpc("aria2.changeGlobalOption", [{key: val}])
        print("%s = %s（本次运行有效；想持久化就改 conf 再重启服务：%s）"
              % (key, val, service_restart_hint()))
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
