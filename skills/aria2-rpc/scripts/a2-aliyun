#!/bin/bash
# 用 a2 下载 AList 中的阿里云盘文件
# 用法: a2-aliyun "AList中的文件路径" [输出目录]

ALIST_URL="http://localhost:5244"
ALIST_USER="admin"
PASSWORD_FILE="$HOME/.alist/admin_password.txt"
DEFAULT_OUTPUT="${A2_DOWNLOAD_DIR:-$HOME/Downloads}"

# 读取密码（优先密码文件，与 a2-ls/a2-alist 一致；避免把凭据写死在脚本里）
if [ -f "$PASSWORD_FILE" ]; then
    ALIST_PASS=$(grep -o 'password: [^ ]*' "$PASSWORD_FILE" | tail -1 | awk '{print $2}')
else
    read -s -p "AList 管理员密码: " ALIST_PASS
    echo ""
fi

if [ -z "$1" ]; then
    echo "用法: $0 \"AList中的文件路径\" [输出目录]"
    echo "示例: $0 \"/aliyun/长安的荔枝/05 4K.mp4\""
    echo "示例: $0 \"/aliyun/长安的荔枝/05 4K.mp4\" ${A2_MEDIA_ROOT:-$HOME/media}/TV"
    exit 1
fi

FILE_PATH="$1"
OUTPUT_DIR="${2:-$DEFAULT_OUTPUT}"

# 登录获取 token
TOKEN=$(curl -s -X POST "$ALIST_URL/api/auth/login" \
  -H "Content-Type: application/json" \
  -d "{\"username\":\"$ALIST_USER\",\"password\":\"$ALIST_PASS\"}" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['token'])")

if [ -z "$TOKEN" ]; then
    echo "错误: 登录 AList 失败"
    exit 1
fi

# 获取文件直链
RESULT=$(curl -s -X POST "$ALIST_URL/api/fs/get" \
  -H "Content-Type: application/json" \
  -H "Authorization: $TOKEN" \
  -d "{\"path\":\"$FILE_PATH\",\"password\":\"\"}")

CODE=$(echo "$RESULT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('code', 0))")

if [ "$CODE" != "200" ]; then
    echo "错误: 获取直链失败"
    echo "$RESULT" | python3 -m json.tool
    exit 1
fi

RAW_URL=$(echo "$RESULT" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['raw_url'])")
FILE_NAME=$(echo "$RESULT" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['name'])")
FILE_SIZE=$(echo "$RESULT" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['size'])")

# 转换大小为可读格式
if [ "$FILE_SIZE" -gt 1073741824 ]; then
    SIZE_STR=$(python3 -c "print(f'{$FILE_SIZE/1073741824:.2f}GB')")
elif [ "$FILE_SIZE" -gt 1048576 ]; then
    SIZE_STR=$(python3 -c "print(f'{$FILE_SIZE/1048576:.2f}MB')")
else
    SIZE_STR=$(python3 -c "print(f'{$FILE_SIZE/1024:.1f}KB')")
fi

echo "文件名: $FILE_NAME"
echo "大小: $SIZE_STR"
echo "输出目录: $OUTPUT_DIR"
echo ""

# 用 a2 下载
echo "正在添加到 a2 下载队列..."
a2 add -o "$OUTPUT_DIR" "$RAW_URL"

echo ""
echo "下载任务已添加！用 'a2 list' 查看进度"
