# =============================================================
# a2 自己的配置（a2 专有；aria2 不读这个文件，所以不会有 Unknown option 警告）
# 位置：~/.aria2/a2.conf   模板：本技能 assets/a2.conf.template（服务定义模板另见 assets/ 下的 plist 与 service）
# 改完立刻生效，不需要重启守护进程（每次跑 a2 都会重新读）
# 环境变量优先级更高，可用于临时覆盖：A2_SERVICE / A2_VERIFY_TIMEOUT / A2_MIN_FREE_GB …
# =============================================================

# 服务名（macOS launchd / Linux systemd unit / Windows 计划任务）：只影响 a2 报错时给的提示命令
# （install-a2.sh 用 A2_SERVICE 决定真实服务名；换过名字这里也改成同一个）
service=__LABEL__

# -------------------------------------------------------------
# 本文件只放「a2 命令自己」的键
# -------------------------------------------------------------
# 搜索不在 a2 里：`a2 find` 已移除，搜索用 skill 层的 `a2-search`，
#   站点配置在 __HOME__/.aria2/search-sites.conf（模板 assets/search-sites.conf.template，
#   契约 references/search-sites.md）。
# 落点（默认下载目录 / 媒体库根）在 __HOME__/.aria2/dest.conf（命令 a2-dest）。
# 这两个都**不要**写进本文件：a2 不读它们，写这里只会让人误以为生效。
