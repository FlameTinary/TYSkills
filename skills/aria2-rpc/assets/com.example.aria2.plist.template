<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS 专用（launchd 用户服务）。Linux 用 assets/a2.service.template（systemd --user）；
     Windows 用计划任务或 nssm，见 references/setup.md §7。 -->
<plist version="1.0">
<dict>
    <!-- 服务名：install-a2.sh 会把 __LABEL__ 换成 A2_SERVICE（默认 com.example.aria2）。
         手工安装时把下面的 __LABEL__ 一并改成同一个名字。 -->
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- 必须用启动器（start-aria2.sh）：它负责校验媒体库所在外接卷是否已挂载，
         并让终端 / launchd / cron 三条启动路径行为一致。 -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.aria2/start-aria2.sh</string>
        <!-- 关键：前台运行，不能加 --daemon=true，否则 launchd 会认为进程秒退而反复重启 -->
        <string>--daemon=false</string>
        <string>--summary-interval=0</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>StandardOutPath</key>
    <string>__HOME__/.aria2/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.aria2/launchd.err.log</string>
</dict>
</plist>
