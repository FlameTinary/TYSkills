# <技能名> 私有配置模板
#
# 复制到：  macOS / Linux   ~/.<技能名>/<技能名>.conf
#           Windows         %USERPROFILE%\.<技能名>\<技能名>.conf
#   （Windows PowerShell: Copy-Item $env:USERPROFILE\.<技能名>\<技能名>.conf.template 目标路径）
# 然后用编辑器填写下面各项。真实配置文件不要提交到版本库（.gitignore 已包含 *.conf）。
#
# 格式：KEY=VALUE，一行一条；# 或 ; 开头为注释；值里可以用 ${别的变量:-默认值} 和 ~
# 优先级：命令行参数 > 环境变量（前缀 <技能名>_ 大写）> 本文件 > 技能内置默认
#  例：设 <技能名>_RPC_PORT=6801（或 RPC_PORT=6801）可临时覆盖本文件的 RPC_PORT。
#
# 填错不要紧：脚本会告诉你缺哪一项、去哪配、模板在哪，但不会回显密钥内容。

# ---------- 路径 ----------
# 主目录（媒体库 / 数据目录 / 缓存目录，按技能自己的语义命名）
# 可以放在任何盘：外部磁盘、网络盘、Windows 盘符都行
# macOS/Linux 例： /Volumes/<你的盘>/media   /mnt/<你的盘>/media   ~/media
# Windows   例： D:\media
# 留空则用技能内置默认（通常是家目录下的位置）
MAIN_DIR=

# 临时/暂存目录（留空 = 系统临时目录）
TMP_DIR=

# ---------- 服务 ----------
# 本机服务端口（确认是软件默认端口，还是你机器上改过的）
PORT=5244

# 本机服务监听地址（只本机用就保持 127.0.0.1，别开 0.0.0.0）
HOST=127.0.0.1

# ---------- 密钥 ----------
# 密钥/令牌：由安装脚本首次运行时随机生成，或从服务方后台复制填入
# 不要用示例值、不要在聊天/issue 里贴出来
SECRET=

# 第三方服务令牌（如网盘 refresh_token、API key）
# 从服务方后台获取；获取方式见技能 README
API_KEY=

# ---------- 外部命令 ----------
# 搜索源/数据源命令（占位符 {query} / {page}，或读环境变量 QUERY/PAGE）
# 例：python3 ~/.<技能名>/my-source.py --q {query} --p {page}
# 留空则相关功能禁用，并给出「去哪配置」的提示
SOURCE_CMD=

# 需要联网时使用的代理（留空 = 直连）
# 例：http://127.0.0.1:7890  socks5h://127.0.0.1:1080
PROXY=

# ---------- 行为开关 ----------
# 最小可用磁盘空间（GB）
MIN_FREE_GB=20

# 完成后是否移动/整理文件（1/0）
ORGANIZE=1

# 日志级别：debug / info / warn / error（info 级别可能吃掉大量磁盘）
LOG_LEVEL=warn
